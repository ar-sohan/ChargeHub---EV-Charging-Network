# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated frontend URLs allowed to call the API (unset = allow all)
CORS_ORIGIN=http://localhost:5123

# ---- Database ----
# Either set DATABASE_URL (Neon / Supabase / Render give you one) ...
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# ... or the individual local settings below.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password
DB_NAME=chargehubEV
# true when the database requires SSL (defaults to true when DATABASE_URL is set)
DB_SSL=false
# Auto-create/alter tables from the entities. Turn off once real data matters.
DB_SYNCHRONIZE=true

# ---- Auth ----
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ---- Email (Gmail needs a 16-character app password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-character-app-password
MAIL_FROM="ChargeHub EV <your-email@gmail.com>"

# ---- Pusher realtime notifications (optional) ----
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
